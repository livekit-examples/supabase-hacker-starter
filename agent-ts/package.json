{
  "name": "supabase-hacker-starter-agent-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "pnpm run build && node dist/main.js dev",
    "download-files": "pnpm run build && node dist/main.js download-files",
    "start": "node dist/main.js start"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.5",
    "@livekit/agents-plugin-livekit": "^1.4.5",
    "@livekit/agents-plugin-silero": "^1.4.5",
    "@livekit/plugins-ai-coustics": "^0.3.5",
    "@livekit/rtc-node": "^1.2.2",
    "@supabase/supabase-js": "^2.108.1",
    "dotenv": "^18.0.10",
    "zod": "^4.0.0"
  }
}

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...) — bypasses RLS. Server-side only; never ship to the browser.
SUPABASE_SECRET_KEY=

# UUID of the seeded demo user (printed by `pnpm db:seed`). Used as the
# identity fallback in console mode and when dispatch metadata is absent.
DEMO_USER_ID=

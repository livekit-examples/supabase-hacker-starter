# Environment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# AGENT_NAME must match the agent's agent_name (Python) / agentName (Node): my-agent.
# Leaving it blank switches to automatic dispatch, which a named agent never receives.
AGENT_NAME=my-agent
# Agent deployment to dispatch to. `pnpm dev:ts` / `pnpm dev:py` run the agent with
# `lk agent dev --deployment local-dev`, which is also the default when this is unset.
# Set it empty to dispatch to the production deployment (an agent started with
# `pnpm agent:*:start`, from the Docker image, or deployed to LiveKit Cloud).
AGENT_DEPLOYMENT=local-dev

# Supabase Auth. The browser signs in anonymously using the publishable key,
# and the /api/token route verifies that session server-side to identify the
# visitor. Find these under Project Settings → API keys in the Supabase
# dashboard (the publishable key looks like sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your_publishable_key>

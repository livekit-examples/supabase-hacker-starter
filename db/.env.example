# Database seed / migration helpers (db/).
# Copy to db/.env.local and fill in. The seed script also falls back to
# agent-ts/.env.local, agent-py/.env.local, or a root .env.local.

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Modern Supabase secret API key (sb_secret_...). Bypasses RLS, like the
# legacy service_role key. Find it under Project Settings -> API Keys.
# Never expose this in the browser or commit it.
SUPABASE_SECRET_KEY=
